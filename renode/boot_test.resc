:name: STM32F407VG_ADS1115
:description: STM32F407VG + ADS1115 (I2C1) - boot test script (Görev 4)

using sysbus

$name?="STM32F407VG_ADS1115"
mach create $name

machine LoadPlatformDescription @renode/platform.repl

# The .elf is built by CMake into build/ (relative to the repo root --
# run this script FROM the repo root, e.g. `renode renode/boot_test.resc`).
$bin?=@build/STM32F407VG_ADS1x1x.elf

# Görev 1: the chosen communication peripheral is USART1, so that's what
# we watch for UART output (not usart2).
showAnalyzer sysbus.usart1

macro reset
"""
    sysbus LoadELF $bin
"""
runMacro $reset

start
