// renode/platform.repl
//
// STM32F407VG + ADS1x1x (I2C1) platform tanimi.
//
// Temel MCU tanimini (CPU, NVIC, GPIO, USART1-5, I2C1-3, timer'lar, DMA, vb.)
// Renode'un resmi olarak bakimini yaptigi cpu-seviyesi dosyadan aliyoruz.
// Bu dosya STM32F407/STM32F405 ailesi icin dogru register adreslerini ve
// interrupt hatlarini zaten iceriyor (I2C1 @ 0x40005400, USART1 @ 0x40011000).
using "platforms/cpus/stm32f4.repl"

// --------------------------------------------------------------------------
// Sensor: ADS1115 (ADS1x1x ailesi), I2C1 uzerinde, adres 0x48 (ADDR->GND)
// --------------------------------------------------------------------------
// NOT: "I2C.ADS1x1x" sinifi henuz mevcut degil -- bu Gorev 5'te C# ile
// yazilacak Renode peripheral modeli. Model tamamlanip Renode'a eklenene
// kadar bu satir aktif edilirse "unable to locate type" hatasi alinir.
// Gorev 5 bitince asagidaki satirin basindaki "//" kaldirilacak.
//
 ads1x1x: I2C.ADS1x1x @ i2c1 0x48
     variant: "ADS1115"

// --------------------------------------------------------------------------
// Simdilik (Gorev 5 tamamlanana kadar) platformu, sensor olmadan,
// sadece STM32'nin Renode uzerinde boot edip etmedigini ve USART1
// uzerinden cikti verip vermedigini test etmek icin kullanabilirsin.
// --------------------------------------------------------------------------
